# Vorlage für scripts/ha_deploy.py. Kopieren nach .ha.env und ausfüllen.
# .ha.env steht in .gitignore, der Token landet also nicht im Repo.
# Die Datei gehört nur auf den eigenen PC, nie in den Container.

# Ordner "blueprints" der Home-Assistant-Konfiguration. Das Skript legt die
# Dateien darunter in automation/dachfenster/ und template/dachfenster/ ab.
#
# Samba-Freigabe (Windows / macOS) ...
HA_BLUEPRINT_ZIEL=\\homeassistant.local\config\blueprints
# ... oder scp über das SSH-Add-on (die Unterordner müssen dort existieren):
# HA_BLUEPRINT_ZIEL=root@homeassistant.local:/config/blueprints/

# Optional: danach Konfiguration prüfen, Automationen und Template-Entitäten
# neu laden. Ob das ohne Adminrechte geht, ist noch nicht geprüft; meldet HA
# 401/403, fehlt dem Benutzer das Recht. Für die Live-Tests (nur lesen) einen
# eigenen Benutzer ohne Adminrechte nehmen, nicht diesen Token.
HA_URL=http://homeassistant.local:8123
HA_TOKEN=
